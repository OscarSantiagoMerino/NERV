# ── MODEL PROVIDER (P3 specialist + CopilotKit runtime) ──────────────────
MODEL_PROVIDER=openai
OPENAI_API_KEY=stub-replace-me
MODEL=gpt-5.6-sol

# ── GITHUB (P3 adapter) ───────────────────────────────────────────────────
# Classic PAT, repo scope. https://github.com/settings/tokens/new
GITHUB_TOKEN=
# owner/name of the repo the specialist reads issues from and creates into.
GITHUB_REPO=OscarSantiagoMerino/NERV

# ── AMBIGUOUS AI (P3 adapter, adenda 2026-09-12 — docs/mvp/CONTRATOS.md §10) ─
# Optional: absent means the Ambiguous export step is skipped, not an error.
# https://www.ambiguous.ai/ -> Connect instructions for your demo workspace.
# AMBIGUOUS_API_KEY=

# ── APP ────────────────────────────────────────────────────────────────
PORT=3100
PUBLIC_APP_ORIGIN=http://127.0.0.1:3100
# NERV_DB_PATH=data/nerv-demo.sqlite
