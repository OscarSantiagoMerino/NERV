# ── MODEL PROVIDER (P3 specialist + CopilotKit runtime) ──────────────────
MODEL_PROVIDER=openai
OPENAI_API_KEY=stub-replace-me
MODEL=gpt-5.6-sol

# ── GITHUB (P3 adapter) ───────────────────────────────────────────────────
# Classic PAT, repo scope. https://github.com/settings/tokens/new
GITHUB_TOKEN=
# owner/name of the repo the specialist reads issues from and creates into.
GITHUB_REPO=OscarSantiagoMerino/NERV

# ── APP ────────────────────────────────────────────────────────────────
PORT=3100
